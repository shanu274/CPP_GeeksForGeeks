

class Solution {
  public:
    vector<int> Rearrange(vector<int> arr) {
        // code here
        int n = arr.size();
        sort(arr.begin(), arr.end());
        
        int temp[n];
        int small = 0, large = n-1;
        bool flag = true;
        
        for(int i = 0; i < n; i++){
            if(flag){
                temp[i] = arr[small++];
            }else{
                temp[i] = arr[large--];
            }
            flag =! flag;
        }
        for(int i = 0; i <n; i++){
            arr[i] = temp[i];
        }
        return arr;
    }
};
