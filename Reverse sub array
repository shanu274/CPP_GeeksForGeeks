// User function template for C++
class Solution {
  public:
    vector<int> reverseSubArray(vector<int> &arr, int l, int r) {
        int i = l-1;
        int j = r-1;
        
        while(i < j){
            swap(arr[j],arr[i]);
            arr[i++];
            arr[j--];
            
        }
        return arr;
    }
};
